<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- 后台播放:MediaSessionService 托管通知与媒体键。
             不需要外部应用绑定:系统通知、锁屏与蓝牙媒体键走的是 MediaSession 框架,
             不是直接 bind 这个 Service,所以这里不导出,也不留外部可发现的 intent-filter。
             会话级还有一道 ControllerInfo 白名单(见 HsyPlaybackService.onConnect)。 -->
        <service
            android:name=".HsyPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
